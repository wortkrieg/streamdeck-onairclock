{
	"name": "streamdeck-onairclock",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"build:dev": "node scripts/build-dev.mjs",
		"watch:dev": "ONAIR_DEV=1 rollup -c -w",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
		"lint": "biome check .",
		"format": "biome format --write .",
		"validate": "streamdeck validate fail.marc.onairclock.sdPlugin",
		"assets": "tsx scripts/build-assets.ts",
		"assets:light": "tsx scripts/build-light-media.ts",
		"assets:collect": "sh scripts/collect-uploads.sh",
		"assets:video": "tsx scripts/build-assets.ts --video"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@elgato/cli": "^1.10.4",
		"@resvg/resvg-js": "^2.6.2",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-node-resolve": "^15.2.2",
		"@rollup/plugin-replace": "^6.0.0",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.0",
		"@tsconfig/node20": "^20.1.2",
		"@types/node": "~24.1.0",
		"gifenc": "^1.0.3",
		"rollup": "^4.0.2",
		"tslib": "^2.6.2",
		"tsx": "^4.0.0",
		"typescript": "^5.2.2",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.4"
	}
}
