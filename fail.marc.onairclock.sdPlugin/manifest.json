{
	"Name": "On Air Clock",
	"Version": "2.0.0.0",
	"Author": "Marc Herrmann",
	"URL": "https://github.com/wortkrieg/streamdeck-onairclock",
	"Description": "A versatile and configurable broadcast-inspired on air clock.",
	"Category": "On Air Clock",
	"CategoryIcon": "action/images/category",
	"Icon": "action/images/actionimage",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{ "Platform": "mac", "MinimumVersion": "12" },
		{ "Platform": "windows", "MinimumVersion": "10" }
	],
	"Nodejs": {
		"Version": "24"
	},
	"Actions": [
		{
			"Name": "OnAir Clock",
			"UUID": "fail.marc.onairclock.action",
			"Icon": "action/images/actionimage",
			"Tooltip": "A versatile On Air Clock",
			"PropertyInspectorPath": "ui/clock.html",
			"Controllers": ["Keypad", "Encoder"],
			"States": [
				{
					"Image": "action/images/image"
				}
			],
			"Encoder": {
				"layout": "layouts/clock.json",
				"Icon": "action/images/actionimage",
				"StackColor": "#0000FF",
				"TriggerDescription": {
					"Push": "Cancel countdown",
					"Touch": "Cancel countdown"
				}
			}
		}
	],
	"UUID": "fail.marc.onairclock"
}
